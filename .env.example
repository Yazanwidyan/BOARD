# Copy to .env.local (git-ignored) and fill in what you need.

# Backend address. Leave unset in development: the app uses the computer
# running the Expo dev server, port 4000. Set it for release builds (https).
# EXPO_PUBLIC_API_URL=https://api.example.com/api

# Continue with Google — OAuth client ids from Google Cloud Console
# (APIs & Services → Credentials). The web client id also goes in the
# backend's GOOGLE_CLIENT_IDS. Needs a new build of the app after setting.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
