{
  "expo": {
    "name": "ReelBoard",
    "slug": "reelboard",
    "scheme": "reelboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/reelboard-icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#151311",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yazanwidyan.reelboard",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/reelboard-android-foreground.png",
        "backgroundImage": "./assets/reelboard-android-background.png",
        "monochromeImage": "./assets/reelboard-android-monochrome.png"
      },
      "package": "com.yazanwidyan.reelboard",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/reelboard-favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/reelboard-splash.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#151311",
          "dark": {
            "image": "./assets/reelboard-splash.png",
            "backgroundColor": "#151311"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReelBoard needs access to your photos so you can set a profile picture."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#151311"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6fc42e1a-0829-4fc9-8c42-86e81ed6408e"
      }
    },
    "owner": "yazanw",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6fc42e1a-0829-4fc9-8c42-86e81ed6408e"
    }
  }
}
